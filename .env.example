# note-scanner backend configuration.
#
# Copy to .env and fill in what you need. Every value is optional except
# ANTHROPIC_API_KEY, and that only when EXTRACTOR=claude — the default local
# Ollama path needs no secret and no .env file at all.
#
# .env is gitignored. Never put a key in a source file or a commit.

# Extraction engine: "ollama" (local, free) or "claude" (paid, higher accuracy).
# Default: ollama
EXTRACTOR=

# --- Ollama: used when EXTRACTOR=ollama ---

# Default: http://localhost:11434
OLLAMA_URL=

# Any vision-capable model you have pulled. Default: qwen2.5vl:7b
OLLAMA_MODEL=

# --- Claude API: used when EXTRACTOR=claude ---

# Required when EXTRACTOR=claude. Get one from console.anthropic.com.
ANTHROPIC_API_KEY=

# Default: claude-opus-5
CLAUDE_MODEL=

# --- Server ---

# Default: 8787 (the frontend dev server uses 8000)
PORT=

# Comma-separated origin allowlist for CORS. Never "*".
# Default: http://localhost:8000
ALLOWED_ORIGINS=

# How long to wait for the model. A 7B vision model on a 1568px photo can take
# 30-120s, so this is deliberately generous. Default: 180000
REQUEST_TIMEOUT_MS=

# Largest upload accepted, in bytes. Phase 1 normalizes images to roughly
# 200-600 KB before upload. Default: 8388608 (8 MB)
MAX_UPLOAD_BYTES=
